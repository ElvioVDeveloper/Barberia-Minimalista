rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Default-Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Global Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isBootstrappedAdmin() {
      return isVerified() && request.auth.token.email == 'danielalvarenga751@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedAdmin() || (isVerified() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    // 3. Validation Blueprints (Anti-Update-Gap)
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'displayName', 'email', 'phone', 'role', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'displayName', 'email', 'phone', 'role', 'createdAt', 'updatedAt']) &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.uid == request.auth.uid &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80 &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 120 &&
        data.phone is string && data.phone.size() >= 0 && data.phone.size() <= 30 &&
        data.role is string && data.role.size() >= 5 && data.role.size() <= 10 &&
        (data.role == 'client' || data.role == 'admin') &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidAdminRecord(data) {
      return data.keys().hasAll(['uid', 'email', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'email', 'createdAt']) &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 120 &&
        data.createdAt is timestamp;
    }

    function isValidBarberService(data) {
      return data.keys().hasAll(['name', 'category', 'description', 'price', 'durationMinutes', 'visibility', 'featured', 'ownerId', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['name', 'category', 'description', 'price', 'durationMinutes', 'visibility', 'featured', 'ownerId', 'createdAt', 'updatedAt']) &&
        data.name is string && data.name.size() >= 2 && data.name.size() <= 80 &&
        data.category is string && data.category.size() >= 5 && data.category.size() <= 10 &&
        (data.category == 'corte' || data.category == 'barba' || data.category == 'ritual' || data.category == 'combo') &&
        data.description is string && data.description.size() >= 4 && data.description.size() <= 280 &&
        data.price is number && data.price >= 0 && data.price <= 50000000 &&
        data.durationMinutes is number && data.durationMinutes >= 10 && data.durationMinutes <= 240 &&
        data.visibility is string && data.visibility.size() == 6 && data.visibility == 'public' &&
        data.featured is bool &&
        data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.ownerId == request.auth.uid &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidBookedSlot(data) {
      return data.keys().hasAll(['date', 'time', 'status', 'serviceId', 'serviceName', 'servicePrice', 'appointmentId', 'ownerId', 'visibility', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['date', 'time', 'status', 'serviceId', 'serviceName', 'servicePrice', 'appointmentId', 'ownerId', 'visibility', 'createdAt', 'updatedAt']) &&
        data.date is string && data.date.size() == 10 && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        data.time is string && data.time.size() == 5 && data.time.matches('^[0-9]{2}:[0-9]{2}$') &&
        data.status is string && data.status.size() >= 6 && data.status.size() <= 10 &&
        (data.status == 'booked' || data.status == 'completed' || data.status == 'cancelled') &&
        data.serviceId is string && data.serviceId.size() >= 1 && data.serviceId.size() <= 128 && data.serviceId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.serviceName is string && data.serviceName.size() >= 2 && data.serviceName.size() <= 80 &&
        data.servicePrice is number && data.servicePrice >= 0 && data.servicePrice <= 50000000 &&
        data.appointmentId is string && data.appointmentId.size() >= 1 && data.appointmentId.size() <= 128 && data.appointmentId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.ownerId == request.auth.uid &&
        data.visibility is string && data.visibility.size() == 6 && data.visibility == 'public' &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidAppointment(data) {
      return data.keys().hasAll(['slotId', 'date', 'time', 'serviceId', 'serviceName', 'servicePrice', 'durationMinutes', 'clientName', 'clientPhone', 'notes', 'status', 'source', 'ownerId', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['slotId', 'date', 'time', 'serviceId', 'serviceName', 'servicePrice', 'durationMinutes', 'clientName', 'clientPhone', 'notes', 'status', 'source', 'ownerId', 'createdAt', 'updatedAt']) &&
        data.slotId is string && data.slotId.size() >= 1 && data.slotId.size() <= 128 && data.slotId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.date is string && data.date.size() == 10 && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        data.time is string && data.time.size() == 5 && data.time.matches('^[0-9]{2}:[0-9]{2}$') &&
        data.serviceId is string && data.serviceId.size() >= 1 && data.serviceId.size() <= 128 && data.serviceId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.serviceName is string && data.serviceName.size() >= 2 && data.serviceName.size() <= 80 &&
        data.servicePrice is number && data.servicePrice >= 0 && data.servicePrice <= 50000000 &&
        data.durationMinutes is number && data.durationMinutes >= 10 && data.durationMinutes <= 240 &&
        data.clientName is string && data.clientName.size() >= 2 && data.clientName.size() <= 80 &&
        data.clientPhone is string && data.clientPhone.size() >= 6 && data.clientPhone.size() <= 30 &&
        data.notes is string && data.notes.size() >= 0 && data.notes.size() <= 240 &&
        data.status is string && data.status.size() >= 9 && data.status.size() <= 10 &&
        (data.status == 'confirmed' || data.status == 'completed' || data.status == 'cancelled') &&
        data.source is string && data.source.size() >= 5 && data.source.size() <= 6 &&
        (data.source == 'online' || data.source == 'walkin' || data.source == 'phone') &&
        data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.ownerId == request.auth.uid &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // Collection 1: /users/{userId} (PII Isolated)
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
      allow list: if isSignedIn() && (resource.data.uid == request.auth.uid || isBootstrappedAdmin());

      allow create: if isVerified() &&
        isValidId(userId) &&
        request.auth.uid == userId &&
        isValidUserProfile(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        (incoming().role == 'client' || isAdmin());

      allow update: if isVerified() &&
        isValidId(userId) &&
        isValidUserProfile(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          (
            request.auth.uid == userId &&
            incoming().role == existing().role &&
            incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'phone', 'updatedAt'])
          )
        );

      allow delete: if isVerified() && isValidId(userId) && isAdmin();
    }

    // Collection 2: /admins/{adminId} (Trusted Admin Registry)
    match /admins/{adminId} {
      allow get: if isSignedIn() && isValidId(adminId) && (request.auth.uid == adminId || isAdmin());
      allow list: if isSignedIn() && (resource.data.uid == request.auth.uid || isBootstrappedAdmin());

      allow create: if isVerified() &&
        isValidId(adminId) &&
        isValidAdminRecord(incoming()) &&
        incoming().uid == adminId &&
        incoming().createdAt == request.time &&
        isAdmin();

      allow update: if isVerified() &&
        isValidId(adminId) &&
        isValidAdminRecord(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        isAdmin() &&
        incoming().diff(existing()).affectedKeys().hasOnly(['email']);

      allow delete: if isVerified() && isValidId(adminId) && isAdmin();
    }

    // Collection 3: /services/{serviceId} (Service Catalog)
    match /services/{serviceId} {
      allow get: if isValidId(serviceId) && (resource.data.visibility == 'public' || isAdmin());
      allow list: if resource.data.visibility == 'public' || isBootstrappedAdmin();

      allow create: if isVerified() &&
        isValidId(serviceId) &&
        isValidBarberService(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isVerified() &&
        isValidId(serviceId) &&
        isValidBarberService(incoming()) &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          (
            existing().ownerId == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly(['name', 'category', 'description', 'price', 'durationMinutes', 'featured', 'updatedAt'])
          )
        );

      allow delete: if isVerified() && isValidId(serviceId) && (existing().ownerId == request.auth.uid || isAdmin());
    }

    // Collection 4: /bookedSlots/{slotId} (PII-Free Public Availability Matrix)
    match /bookedSlots/{slotId} {
      allow get: if isValidId(slotId) && (resource.data.visibility == 'public' || isAdmin());
      allow list: if resource.data.visibility == 'public' || isBootstrappedAdmin();

      allow create: if isVerified() &&
        isValidId(slotId) &&
        isValidBookedSlot(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        existsAfter(/databases/$(database)/documents/appointments/$(incoming().appointmentId));

      allow update: if isVerified() &&
        isValidId(slotId) &&
        isValidBookedSlot(incoming()) &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          (
            existing().ownerId == request.auth.uid &&
            existing().status != 'completed' &&
            existing().status != 'cancelled' &&
            (
              // Action 1: Status Update (Cancel or Complete)
              incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) ||
              // Action 2: Reschedule Slot
              incoming().diff(existing()).affectedKeys().hasOnly(['date', 'time', 'serviceId', 'serviceName', 'servicePrice', 'status', 'updatedAt'])
            )
          )
        );

      allow delete: if isVerified() && isValidId(slotId) && (existing().ownerId == request.auth.uid || isAdmin());
    }

    // Collection 5: /appointments/{appointmentId} (PII-Isolated Private Reservations)
    match /appointments/{appointmentId} {
      allow get: if isSignedIn() && isValidId(appointmentId) && (resource.data.ownerId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isBootstrappedAdmin());

      allow create: if isVerified() &&
        isValidId(appointmentId) &&
        isValidAppointment(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        existsAfter(/databases/$(database)/documents/bookedSlots/$(incoming().slotId));

      allow update: if isVerified() &&
        isValidId(appointmentId) &&
        isValidAppointment(incoming()) &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          (
            existing().ownerId == request.auth.uid &&
            existing().status != 'completed' &&
            existing().status != 'cancelled' &&
            (
              // Action 1: Cancel or Complete Appointment
              incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) ||
              // Action 2: Modify Appointment Details
              incoming().diff(existing()).affectedKeys().hasOnly(['slotId', 'date', 'time', 'serviceId', 'serviceName', 'servicePrice', 'durationMinutes', 'clientName', 'clientPhone', 'notes', 'status', 'updatedAt'])
            )
          )
        );

      allow delete: if isVerified() && isValidId(appointmentId) && (existing().ownerId == request.auth.uid || isAdmin());
    }
  }
}
